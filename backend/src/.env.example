# Embeddings: NVIDIA, free, no credit card
# https://build.nvidia.com/settings
NVIDIA_API_KEY=nvapi-...

# Chat. Groq, free, no credit card: https://console.groq.com/keys
# List what your key can reach:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=gsk_...

# Only after creating the role and database (see README)
DATABASE_URL=postgresql://rag:choose-something@localhost:5432/rag
